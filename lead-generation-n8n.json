        "messages": {
          "values": [
            {
              "content": "=Analyze this professional lead to determine whether they could be a potential investor or investment decision-maker for our product/company.\n\nLead information:\n\nName: {{$json.name}}\nCompany: {{$json.company}}\nJob title: {{$json.job_title}}\nLinkedIn: {{$json.linkedin_url}}\nEmail: {{$json.email}}\n\nEvaluate:\n1. Is this person likely to be an investor, founder, CEO, venture capitalist, angel investor, or investment decision-maker?\n2. How relevant is their professional role to investing in a product/company?\n3. Give an investor potential score from 1 to 100.\n4. Give a short reason for the score.\n\nReturn exactly:\n\nInvestor Score: [number]\nInvestor Type: [type or \"Not identified\"]\nReason: [short reason]"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "id": "8c8a683a-1051-4d35-ae57-b7836f884668",
      "name": "Message a model",
      "credentials": {
        "ollamaApi": {
          "id": "8hjfrYdv8phIxBmf",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const originalLeads = $('Extract from File').all();\n\nreturn items.map((item, index) => {\n  const lead = originalLeads[index].json;\n  const content = item.json.content || \"\";\n\n  const scoreMatch = content.match(/Investor Score:\\s*(\\d+)/i);\n\n  // Determine type primarily from the person's actual job title\n  const title = (lead.job_title || \"\").toLowerCase();\n\n  let investorType = \"Not identified\";\n\n  if (\n    title.includes(\"venture capital\") ||\n    title.includes(\"vc\") ||\n    title.includes(\"venture partner\")\n  ) {\n    investorType = \"Venture Capitalist\";\n  } else if (\n    title.includes(\"angel investor\") ||\n    title.includes(\"angel\")\n  ) {\n    investorType = \"Angel Investor\";\n  } else if (\n    title.includes(\"founder\") ||\n    title.includes(\"co-founder\") ||\n    title.includes(\"cofounder\")\n  ) {\n    investorType = \"Founder\";\n  } else if (title.includes(\"ceo\")) {\n    investorType = \"CEO\";\n  } else if (\n    title.includes(\"investor\") ||\n    title.includes(\"investment\")\n  ) {\n    investorType = \"Investor\";\n  }\n\n  const reasonMatch = content.match(\n    /Reason:\\s*([\\s\\S]*?)(?:\\n\\n|$)/i\n  );\n\n  return {\n    json: {\n      name: lead.name,\n      company: lead.company,\n      job_title: lead.job_title,\n      email: lead.email,\n      linkedin_url: lead.linkedin_url,\n      investor_score: scoreMatch ? Number(scoreMatch[1]) : null,\n      investor_type: investorType,\n      reason: reasonMatch ? reasonMatch[1].trim() : \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
