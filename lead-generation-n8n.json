          "id": "8hjfrYdv8phIxBmf",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const originalLeads = $('Extract from File').all();\n\nreturn items.map((item, index) => {\n  const lead = originalLeads[index].json;\n  const content = item.json.content || '';\n\n  const scoreMatch = content.match(/Lead Score:\\s*(\\d+)/i);\n  const reasonMatch = content.match(/Reason:\\s*(.*)/is);\n\n  return {\n    json: {\n      name: lead.name,\n      company: lead.company,\n      job_title: lead.job_title,\n      email: lead.email,\n      linkedin_url: lead.linkedin_url,\n      lead_score: scoreMatch ? Number(scoreMatch[1]) : null,\n      reason: reasonMatch ? reasonMatch[1].trim() : ''\n    }\n  };\n});"
      },
